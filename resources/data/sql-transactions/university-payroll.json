    {
      "id": "lesson-07",
      "title": "SQL Query",
      "blocks": [
        {
          "shared": "block-20"
        },
        {
          "type": "code",
          "caption": "Representative SQL and guarded updates",
          "language": "sql",
          "source": "-- Calculation snapshot before approval; bound values come from the effective salary structure.\nSTART TRANSACTION;\nSELECT id, status FROM payroll_runs WHERE id = 1 FOR UPDATE;\nUPDATE payroll_items JOIN payroll_runs ON payroll_runs.id = payroll_items.payroll_run_id\nSET payroll_items.gross_salary = 50000.00 + 20000.00 + 10000.00,\n payroll_items.deductions = 5000.00, payroll_items.net_salary = 50000.00 + 20000.00 + 10000.00 - 5000.00\nWHERE payroll_items.id = 20001 AND payroll_items.status = 'READY'\nAND payroll_runs.status IN ('DRAFT','CALCULATED');\n-- Recalculation is allowed ONLY while the parent run is DRAFT/CALCULATED and locked.\nSELECT SUM(gross_salary), SUM(deductions), SUM(net_salary) FROM payroll_items WHERE payroll_run_id = 1;\nCOMMIT;\n-- The guard prevents recalculating the PROCESSING sample run.\n-- Separate transaction after a verified bank SUCCESS:\nSTART TRANSACTION;\nSELECT * FROM bank_payment_requests WHERE id = 30001 FOR UPDATE;\nSELECT id, status FROM payroll_items WHERE id = 20001 FOR UPDATE;\n-- If already SUCCESS, return existing result without creating a second slip.\nUPDATE bank_payment_requests SET status = 'SUCCESS', external_reference = 'BANK-SAL-001' WHERE id = 30001;\nUPDATE payroll_items SET status = 'SUCCESS' WHERE id = 20001;\nINSERT INTO salary_slips (id, payroll_item_id, slip_no, net_salary, status)\nVALUES (40001, 20001, 'SLIP-2026-09-0001', 75000.00, 'PENDING');\nCOMMIT;"
        },
        {
          "shared": "block-22"
        }
      ]
    },
